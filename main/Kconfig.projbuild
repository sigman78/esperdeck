menu "Cyberdeck Configuration"

    menu "Terminal font"

    comment "Sizes selectable at runtime (Config > Font, applied on reboot)"

    config CYBERDECK_FONT_RT_8X16
        bool "Terminus 8x16 (100x30 grid)"
        default y
    config CYBERDECK_FONT_RT_10X20
        bool "Terminus 10x20 (80x24 grid)"
        default y
    config CYBERDECK_FONT_RT_12X24
        bool "Terminus 12x24 (66x20 grid)"
        default y

    comment "WARNING: enable at least one font size"
        depends on !CYBERDECK_FONT_RT_8X16 && !CYBERDECK_FONT_RT_10X20 && \
                   !CYBERDECK_FONT_RT_12X24

    choice CYBERDECK_FONT_DEFAULT
        prompt "Font used before one is chosen"
        default CYBERDECK_FONT_DEFAULT_8X16
        help
            Applied on first boot and whenever the stored choice names a size
            that is not enabled above (a setting can outlive a Kconfig
            change). If this size is disabled too, the first enabled one wins.

        config CYBERDECK_FONT_DEFAULT_8X16
            bool "8x16"
        config CYBERDECK_FONT_DEFAULT_10X20
            bool "10x20"
        config CYBERDECK_FONT_DEFAULT_12X24
            bool "12x24"
    endchoice

    endmenu

    config CYBERDECK_FONT_BOLD
        bool "Real bold glyphs (Terminus bold face)"
        default y
        help
            Store the Terminus bold face for ASCII, Latin-1/Extended-A and
            Cyrillic (~6.6 / 16.5 / 19.8 KB internal DRAM at 8x16 / 10x20 /
            12x24). SGR-bold text renders with true bold glyphs; codepoints
            outside the subset fall back to the bold-pop color effect.
            Disable to reclaim the DRAM.

    config SCROLLBACK_LINES
        int "Scrollback buffer (lines)"
        default 1000
        range 0 10000
        help
            Number of lines to keep in scrollback buffer.
            Requires additional PSRAM. Set to 0 to disable.

    config DEFAULT_FG_COLOR
        int "Default foreground color (0-255)"
        default 7
        range 0 255
        help
            Default text foreground color (ANSI 256-color palette).
            7 = white/light gray

    config DEFAULT_BG_COLOR
        int "Default background color (0-255)"
        default 0
        range 0 255
        help
            Default text background color (ANSI 256-color palette).
            0 = black

    config SSH_KEEPALIVE_INTERVAL
        int "SSH keep-alive interval (seconds)"
        default 60
        range 0 300
        help
            Send SSH keep-alive packets every N seconds.
            Set to 0 to disable keep-alive.

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) for the WiFi connection.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            WiFi password (WPA or WPA2).

    config SSH_DEFAULT_HOST
        string "Default SSH host"
        default "192.168.1.100"
        help
            Default SSH server hostname or IP address.

    config SSH_DEFAULT_PORT
        int "Default SSH port"
        default 22
        range 1 65535
        help
            Default SSH server port.

    config SSH_DEFAULT_USER
        string "Default SSH username"
        default "user"
        help
            Default SSH username for authentication.

    config SSH_DEFAULT_PASSWORD
        string "Default SSH password"
        default ""
        help
            Default SSH password. Leave empty if using key-based auth or
            if the server uses keyboard-interactive with a different password.

    config SSH_AUTO_RECONNECT
        bool "Automatically reconnect on SSH session drop"
        default n
        help
            When enabled, the main task transitions back to SSH_CONNECT after
            a session ends or drops.  When disabled, it halts in STATE_ERROR
            so the disconnect is visible and must be reset manually.

    config CYBERDECK_TZ
        string "POSIX timezone for the on-screen clock"
        default "UTC0"
        help
            POSIX TZ string applied at boot; the clock shows local time
            once NTP syncs (fetched once at first WiFi link-up).
            Examples: "UTC0", "MSK-3", "CET-1CEST,M3.5.0,M10.5.0/3",
            "EST5EDT,M3.2.0,M11.1.0".

    config CYBERDECK_NTP_SERVER
        string "NTP server for the on-screen clock"
        default "pool.ntp.org"
        help
            Hostname queried once (UDP port 123) after the first WiFi
            link-up. Point at a local server on isolated networks.

    config SSH_RECV_WINDOW
        int "SSH receive window size (bytes)"
        default 32768
        range 4096 262144
        help
            Advertised SSH channel receive window. The server will not send more
            than this many bytes before waiting for our acknowledgment.
            Smaller values reduce libssh2 heap (packet brigade) at the cost of
            more round-trips for bulk output. 32768 (32 KB) covers any terminal
            screen refresh.

    config SSH_WIFI_PS_NONE
        bool "Disable WiFi power-save while an SSH session is open"
        default y
        help
            The IDF default (WIFI_PS_MIN_MODEM) gates receive wakeups on the
            AP's DTIM beacon, adding tens of ms to every round-trip — that
            caps redraw throughput (TCP window / RTT) and delays each key
            echo. When enabled, the client switches to WIFI_PS_NONE for the
            lifetime of each SSH session and restores WIFI_PS_MIN_MODEM on
            disconnect. Costs radio power while a session is open. With the
            BLE keyboard connected, WiFi/BT coexistence still time-slices
            the radio, so the gain is real but smaller than on WiFi alone.

endmenu
