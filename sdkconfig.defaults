# Cyberdeck — ESP32-S3 build defaults (Waveshare ESP32-S3-Touch-LCD-7).
# A fresh clone builds from these; the gitignored sdkconfig holds local
# overrides (real WiFi/SSH credentials go there or into sim_storage/).

CONFIG_IDF_TARGET="esp32s3"

# ---- flash / partitions -------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- CPU / PSRAM --------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Task stacks may live in PSRAM — but NOT for tasks doing flash I/O; the
# shell's main task allocates its stack from internal DRAM explicitly.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# Deliberately NOT setting CONFIG_SPIRAM_USE_MALLOC: plain malloc() must
# stay internal-DRAM — the display ISR reads app buffers allocated with it.

# ---- display ------------------------------------------------------------
# Keep the RGB bounce-buffer ISR alive during flash writes (NVS bond
# persist while pairing, littlefs profile saves) — the whole render path
# (ISR wrapper, render core, font, cell buffers) is IRAM/DRAM resident.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=y
CONFIG_GDMA_ISR_HANDLER_IN_IRAM=y

# ---- BLE keyboard (NimBLE HID host) --------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# For keyboards that rotate resolvable private addresses (e.g. Apple),
# host-based privacy lets the reconnect scan match them:
# CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=y

# ---- SSH ------------------------------------------------------------------
# Import-over-WiFi web form: desktop browsers send ~1 KB of request headers
# (sec-ch-ua, Sec-Fetch-*, Origin…); the 512 B default makes httpd reject
# form POSTs with 431. Scratch buffer is per-request and transient.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048

CONFIG_SSH_KEEPALIVE_INTERVAL=30
CONFIG_SSH_RECV_WINDOW=32768
CONFIG_SSH_AUTO_RECONNECT=y
# Kill DTIM-gated RX latency while a session is open (docs/speedup-render.md #2)
CONFIG_SSH_WIFI_PS_NONE=y

# Render speedup #3 (docs/speedup-render.md): TCP window 4xMSS -> 8xMSS so the
# post-drain-loop throughput isn't window/RTT-bound. RX pbufs are SPIRAM-first
# (SPIRAM_TRY_ALLOCATE_WIFI_LWIP above) so this costs no internal DRAM.
# RECVMBOX rule: TCP_WND/MSS + 2.
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12

# On-screen clock: US Pacific with DST (PST/PDT)
CONFIG_CYBERDECK_TZ="PST8PDT,M3.2.0,M11.1.0"

# SRAM diet: bookkeeping heaps to PSRAM
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM_PREFER=y

# DEV (temporary): web-import page carries the proof code hidden — no code
# entry needed; the page is open to anyone on the LAN. Flip to n for release.
CONFIG_SSH_IMPORT_POP_DISABLED=y
