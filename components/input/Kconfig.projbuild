menu "Input HAL"

    choice INPUT_BACKEND
        prompt "Input backend"
        default INPUT_AUTO
        help
            Select which input backend(s) to compile and initialise.
            AUTO enables both BLE HID and USB-Serial-JTAG simultaneously.

        config INPUT_AUTO
            bool "AUTO (BLE HID + USB-Serial-JTAG)"

        config INPUT_BLE
            bool "BLE HID only"

        config INPUT_UART
            bool "USB-Serial-JTAG only"
    endchoice

    config INPUT_BLE_SCAN_DURATION
        int "BLE scan duration (seconds)"
        depends on INPUT_BLE || INPUT_AUTO
        default 10
        range 1 60
        help
            How long each scan window lasts before giving up and waiting
            for the next reconnect attempt.

    config INPUT_TOUCH
        bool "Enable GT911 touch input backend"
        default y

    config INPUT_TOUCH_I2C_PORT
        int "I2C port number for GT911"
        default 0
        depends on INPUT_TOUCH

    config INPUT_TOUCH_SDA_PIN
        int "SDA GPIO pin for GT911"
        default 8
        depends on INPUT_TOUCH

    config INPUT_TOUCH_SCL_PIN
        int "SCL GPIO pin for GT911"
        default 9
        depends on INPUT_TOUCH

    config INPUT_TOUCH_WAVESHARE_RESET
        bool "Enable Waveshare Touch-LCD-7 hardware reset sequence"
        depends on INPUT_TOUCH
        default y
        help
            The Waveshare ESP32-S3-Touch-LCD-7 routes GT911 RST and INT
            through I2C IO expanders (0x24 and 0x38).  Enable to run the
            required reset sequence at startup.  Disable only when using
            a bare GT911 with direct GPIO wiring.

    config INPUT_TOUCH_RESET_GPIO
        int "Board enable GPIO pin for GT911 reset"
        depends on INPUT_TOUCH && INPUT_TOUCH_WAVESHARE_RESET
        default 4
        range 0 48

    config INPUT_TOUCH_SCROLL
        bool "Right-edge drag scrolls the scrollback"
        depends on INPUT_TOUCH && VTERM_SCROLLBACK_LINES != 0
        default y
        help
            Compiles in the edge-drag gesture and its SYSTEM menu toggle.
            A press starting in the right-edge strip and moving vertically
            pages the scrollback instead of producing a tap.

            Pointless without scrollback, hence the dependency: with
            VTERM_SCROLLBACK_LINES at 0 there is nothing to scroll and this
            option disappears.

            The gesture itself is switched on and off from the menu at
            runtime; this only decides whether it exists in the build.

    config INPUT_TOUCH_SCROLL_EDGE_PX
        int "Width of the right-edge scroll strip (pixels)"
        depends on INPUT_TOUCH_SCROLL
        default 48
        range 16 200
        help
            How far in from the right edge a press may start and still be
            taken as a scroll drag. 48 px is about a finger width on the
            7" panel, and six character cells at the 8x16 font.

    config INPUT_TOUCH_SCROLL_SPEED_PCT
        int "Scroll drag speed (percent of 1:1)"
        depends on INPUT_TOUCH_SCROLL
        default 150
        range 25 500
        help
            How far the view moves per unit of finger travel, as a
            percentage. 100 is 1:1 — the text tracks the finger exactly.
            150 (the default) moves half again as fast, which covers more
            of a long buffer without losing the sense of dragging the
            content itself.

            Applied to accumulated pixels, so the fraction is not lost:
            a slow drag still scrolls, it just takes more travel per row.

endmenu
