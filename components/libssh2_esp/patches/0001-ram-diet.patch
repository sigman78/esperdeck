diff --git i/src/keepalive.c w/src/keepalive.c
index 061e1d91..ea1e49dd 100644
--- i/src/keepalive.c
+++ w/src/keepalive.c
@@ -47,6 +47,11 @@ void libssh2_keepalive_config(LIBSSH2_SESSION *session,
     else
         session->keepalive_interval = ssh2_sec_to_timediff(interval_s);
     session->keepalive_want_reply = want_reply ? 1 : 0;
+    /* Start the clock now. The session is calloc'd, so leaving this at 0 makes
+       the very first libssh2_keepalive_send() fire immediately instead of
+       after `interval` - which can push a GLOBAL_REQUEST out at a point in the
+       protocol where it is not yet legal. */
+    session->keepalive_last_sent = ssh2_now();
 }
 
 int libssh2_keepalive_send(LIBSSH2_SESSION *session, int *seconds_to_next)
