diff --git i/src/pem.c w/src/pem.c
index 18c091b5..c67b1eb5 100644
--- i/src/pem.c
+++ w/src/pem.c
@@ -459,8 +459,11 @@ static int pem_parse_data_openssh(LIBSSH2_SESSION *session,
 
     if((!passphrase || strlen(passphrase) == 0) &&
        !SSH2_IS_LITERAL(ciphername, ciphername_len, "none")) {
-        /* passphrase required */
-        ret = LIBSSH2_ERROR_KEYFILE_AUTH_FAILED;
+        /* passphrase required - say so, otherwise the caller reports a
+           blank error and the user cannot tell this apart from a corrupt
+           key file. */
+        ret = ssh2_err(session, LIBSSH2_ERROR_KEYFILE_AUTH_FAILED,
+                       "encrypted key requires a passphrase");
         goto out;
     }
 
diff --git i/src/transport.c w/src/transport.c
index c7c42c3a..5e3d3e6f 100644
--- i/src/transport.c
+++ w/src/transport.c
@@ -1079,7 +1079,7 @@ int ssh2_transport_send(LIBSSH2_SESSION *session,
         /* the idea here is that these function must fail if the output gets
            larger than what fits in the assigned buffer so thus they do not
            check the input size as we do not know how much it compresses */
-        size_t dest_len = MAX_SSH_PACKET_LEN - 5 - 256;
+        size_t dest_len = LIBSSH2_OUTBUF_LEN - 5 - 256;
         size_t dest2_len = dest_len;
 
         /* compress directly to the target buffer */
@@ -1109,7 +1109,7 @@ int ssh2_transport_send(LIBSSH2_SESSION *session,
         data_len = dest_len + dest2_len; /* use the combined length */
     }
     else {
-        if((data_len + data2_len) >= (MAX_SSH_PACKET_LEN - 0x100))
+        if((data_len + data2_len) >= (LIBSSH2_OUTBUF_LEN - 0x100))
             /* too large packet, return error for this until we make this
                function split it up and send multiple SSH packets */
             return LIBSSH2_ERROR_INVAL;
