+ * Shrinking this from MAX_SSH_PACKET_LEN (35 KB) saves ~30 KB from the
+ * session struct without affecting receive capacity. */
+#define LIBSSH2_OUTBUF_LEN 4096
+
 #define PACKETBUFSIZE MAX_SSH_PACKET_LEN
 
 struct transportpacket {
