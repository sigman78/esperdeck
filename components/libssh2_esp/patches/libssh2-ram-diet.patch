diff --git i/src/libssh2_priv.h w/src/libssh2_priv.h
index f1d6d606..0bc5f8a1 100644
--- i/src/libssh2_priv.h
+++ w/src/libssh2_priv.h
@@ -609,6 +609,12 @@ struct endpoint_data {
     char *lang_prefs;
 };
 
+/* Send buffer.  A terminal client never sends packets larger than a few KB
+ * (KEXINIT algorithm list is the largest, ~1.5 KB with default prefs).
+ * Shrinking this from MAX_SSH_PACKET_LEN (35 KB) saves ~30 KB from the
+ * session struct without affecting receive capacity. */
+#define LIBSSH2_OUTBUF_LEN 4096
+
 #define PACKETBUFSIZE MAX_SSH_PACKET_LEN
 
 struct transportpacket {
@@ -637,7 +643,7 @@ struct transportpacket {
                                are currently writing decrypted data */
 
     /* ------------- for outgoing data --------------- */
-    unsigned char outbuf[MAX_SSH_PACKET_LEN]; /* area for the outgoing data */
+    unsigned char outbuf[LIBSSH2_OUTBUF_LEN]; /* area for the outgoing data */
 
     ssize_t ototal_num;     /* size of outbuf in number of bytes */
     const unsigned char *odata; /* original pointer to the data */
@@ -804,7 +810,7 @@ struct _LIBSSH2_SESSION {
     /* State variables used in session_banner_receive(),
        session_banner_send() */
     ssh2_NB_states banner_TxRx_state;
-    char banner_TxRx_banner[8192];
+    char banner_TxRx_banner[512]; /* SSH banners are rarely > 100 bytes */
     ssize_t banner_TxRx_total_send;
 
     /* State variables used in kexinit() */
diff --git i/src/transport.c w/src/transport.c
index bd0f273f..589d3732 100644
--- i/src/transport.c
+++ w/src/transport.c
@@ -1051,7 +1051,7 @@ int ssh2_transport_send(LIBSSH2_SESSION *session,
         /* the idea here is that these function must fail if the output gets
            larger than what fits in the assigned buffer so thus they do not
            check the input size as we do not know how much it compresses */
-        size_t dest_len = MAX_SSH_PACKET_LEN - 5 - 256;
+        size_t dest_len = LIBSSH2_OUTBUF_LEN - 5 - 256;
         size_t dest2_len = dest_len;
 
         /* compress directly to the target buffer */
@@ -1081,7 +1081,7 @@ int ssh2_transport_send(LIBSSH2_SESSION *session,
         data_len = dest_len + dest2_len; /* use the combined length */
     }
     else {
-        if((data_len + data2_len) >= (MAX_SSH_PACKET_LEN - 0x100))
+        if((data_len + data2_len) >= (LIBSSH2_OUTBUF_LEN - 0x100))
             /* too large packet, return error for this until we make this
                function split it up and send multiple SSH packets */
             return LIBSSH2_ERROR_INVAL;
